---
import BaseLayout from '../layouts/BaseLayout.astro';
import PizzaVisuel from '../components/PizzaVisuel.astro';
import { commerce } from '../config/commerce';
import { pizzasVisibles } from '../lib/catalogue';
import { textes } from '../content/textes';
import { url } from '../lib/url';

const p = pizzasVisibles()[0];
---
<BaseLayout title={`Page introuvable — ${commerce.nom}`} description="Cette page n’existe pas.">
  <div class="conteneur page-404">
    {p && <div class="page-404__disque" aria-hidden="true"><PizzaVisuel pizza={p} /></div>}
    <h1>Cette page est introuvable</h1>
    <p>Le lien est peut-être ancien. Retrouvez mes pizzas sur la carte.</p>
    <div class="boutons">
      <a class="btn btn--tomate" href={url('carte/')}>{textes.accueil.boutonCarte}</a>
      <a class="btn btn--clair" href={url()}>{textes.nav.accueil}</a>
    </div>
  </div>
</BaseLayout>
