---
import BaseLayout from '../layouts/BaseLayout.astro';
import { metaParPage, donneesStructurees } from '../lib/seo';
import PizzaCarte from '../components/PizzaCarte.astro';
import PizzaIllustration from '../components/PizzaIllustration.astro';
import Photo from '../components/Photo.astro';
import Revele from '../components/Revele.astro';
import ChaineWhatsapp from '../components/ChaineWhatsapp.astro';
import Marquee from '../components/Marquee.astro';
import { commerce } from '../config/commerce';
import { textes } from '../content/textes';
import { pizzasVisibles } from '../lib/catalogue';
import { url } from '../lib/url';
import { imageHero, photoAmbiance } from '../components/marque';
import { DISQUE_MARQUE } from '../components/illustration';
import { libelles } from '../components/libelles';
import { joursDistribution } from '../components/outils';

const visibles = pizzasVisibles();
const selection = visibles.slice(-4);
const rq = commerce.remises.quantite;
const jours = joursDistribution();
const finale = visibles.find((p) => p.id === 'chevre-miel') ?? visibles[0];

// Photos : uniquement si apparence.photos = true (sinon ces valeurs sont null)
const heros = await imageHero();
const paton = await photoAmbiance('paton.jpg');
---
<BaseLayout title={metaParPage.accueil.title} description={metaParPage.accueil.description} jsonLd={donneesStructurees()}>
  <section class="hero sur-rouge" aria-labelledby="titre-hero" data-hero>
    <div class="hero__halo" aria-hidden="true" data-halo></div>
    <div class="conteneur hero__grille">
      <Revele tag="h1" id="titre-hero" class="hero__accroche" texte={textes.accueil.accroche} mixte immediat />
      <div class="hero__disque" data-disque>
        <div class="hero__rot">
          {heros ? (
            <div class="cadre cadre--rond"><Photo src={heros} nom="hero" alt="Une de mes pizzas, tout juste sortie du four" widths={[640, 960]} sizes="(min-width: 900px) 46vw, 90vw" priorite /></div>
          ) : (
            <PizzaIllustration pizza={DISQUE_MARQUE} libelle="Disque graphique aux couleurs de la carte : croûte ocre, sauce rouge, cercles de mozzarella, feuilles de basilic" class="hero__pizza" />
          )}
        </div>
      </div>
      <div class="boutons hero__actions">
        <a class="btn btn--tomate btn--grand" href={url('commande/')}>{textes.accueil.boutonCommander}</a>
        <a class="lien-gras" href={url('carte/')}>{textes.accueil.boutonCarte}</a>
      </div>
      <p class="hero__intro">{textes.accueil.intro}</p>
    </div>
  </section>

  <Marquee />

  {selection.length > 0 && (
    <section class="section section--creme" aria-labelledby="titre-selection">
      <div class="conteneur">
        <div class="section__tete">
          <div>
            <Revele tag="h2" id="titre-selection" texte={textes.accueil.selection.titre} />
            <p class="section__sous">{textes.accueil.selection.sousTitre}</p>
          </div>
          <a class="btn btn--noir" href={url('carte/')}>{textes.accueil.selection.lienToutVoir}</a>
        </div>
        <div class="plats">
          {selection.map((p) => <PizzaCarte pizza={p} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section section--jaune" aria-labelledby="titre-concept">
    <div class="conteneur">
      <div class="section__tete"><Revele tag="h2" id="titre-concept" texte={textes.accueil.concept.titre} /></div>
      <ol class="etapes">
        {textes.accueil.concept.etapes.map((e, i) => (
          <li data-reveal>
            <span class="etapes__num" aria-hidden="true">{i + 1}</span>
            <h3>{e.titre}</h3>
            <p>{e.texte}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--noir sur-noir" aria-labelledby="titre-avantages">
    <div class="conteneur">
      <div class="chiffres" data-reveal>
        <p class="chiffre"><span class="chiffre__n" data-compte={visibles.length}>{visibles.length}</span><span class="chiffre__t">{libelles.chiffrePizzas}</span></p>
        {rq.actif && <p class="chiffre"><span class="chiffre__n"><span data-compte={rq.pourcentage}>{rq.pourcentage}</span> %</span><span class="chiffre__t">{libelles.chiffreRemise(rq.aPartirDe)}</span></p>}
        <p class="chiffre"><span class="chiffre__n" data-compte={commerce.distribution.jours.length}>{commerce.distribution.jours.length}</span><span class="chiffre__t">{libelles.chiffreJours}</span></p>
      </div>
      <div class={paton ? 'duo' : ''}>
        {paton && (
          <div class="duo__visuel"><div class="cadre"><Photo src={paton} nom="paton.jpg" alt="Un pâton rond posé sur un lit de semoule" widths={[480, 720]} sizes="(min-width: 960px) 45vw, 100vw" /></div></div>
        )}
        <div>
          <Revele tag="h2" id="titre-avantages" texte={textes.accueil.avantages.titre} />
          <ul class="avantages">
            {textes.accueil.avantages.items.map((a) => (
              <li data-reveal><h3>{a.titre}</h3><p>{a.texte}</p></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--creme" aria-label="Infos pratiques">
    <div class="conteneur">
      <div class="pratique" data-reveal>
        <div>
          <h3>{textes.contact.jours.titre}</h3>
          <p class="pratique__gros">{jours.replace(/^./, (c) => c.toUpperCase())}</p>
        </div>
        <div>
          <h3>{textes.contact.retrait.titre}</h3>
          <p class="pratique__gros">{commerce.adresseRetrait}</p>
          {commerce.livraison.actif && <p>{textes.contact.livraison.titre}</p>}
        </div>
        {rq.actif && (
          <div>
            <h3>{libelles.remisesLigne}</h3>
            <p class="pratique__gros">{libelles.remiseQuantite(rq.pourcentage, rq.aPartirDe)}</p>
          </div>
        )}
        {commerce.mentionStock && <p class="pratique__stock">{commerce.mentionStock}</p>}
      </div>
    </div>
  </section>

  {commerce.chaineWhatsapp && (
    <section class="section section--jaune" aria-labelledby="titre-chaine">
      <div class="conteneur" data-reveal>
        <ChaineWhatsapp />
      </div>
    </section>
  )}

  <section class="section section--rouge sur-rouge final" aria-labelledby="titre-final">
    <div class="conteneur final__grille">
      <div class="final__texte">
        <Revele tag="h2" id="titre-final" class="final__titre" texte={textes.accueil.final.titre} />
        <p>{textes.accueil.final.texte}</p>
        <div class="boutons">
          <a class="btn btn--tomate btn--grand" href={url('commande/')}>{textes.accueil.boutonCommander}</a>
          <a class="lien-gras" href={url('carte/')}>{textes.accueil.boutonCarte}</a>
        </div>
      </div>
      <div class="final__disque" aria-hidden="true">
        <PizzaIllustration pizza={finale} libelle={`Pizza ${finale.nom} : composition graphique`} />
      </div>
    </div>
  </section>
</BaseLayout>
