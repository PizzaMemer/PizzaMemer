---
import type { Pizza } from '../lib/types';
import { rs } from '../lib/format';
import { textes } from '../content/textes';
import PizzaVisuel from './PizzaVisuel.astro';
import { libelles } from './libelles';
import { jourMois } from './outils';

interface Props {
  pizza: Pizza;
  /** Niveau du titre : 2 sur la page carte (sous le h1), 3 dans une section. */
  niveau?: 2 | 3;
}
const { pizza, niveau = 3 } = Astro.props;
const Titre = `h${niveau}` as 'h2' | 'h3';
const idTitre = `plat-${pizza.id}`;
---
<article class:list={['plat', !pizza.disponible && 'plat--indispo']} data-reveal aria-labelledby={idTitre}>
  <PizzaVisuel pizza={pizza} class="plat__visuel" />
  <div class="plat__corps">
    <div class="plat__tete">
      <Titre id={idTitre} class="plat__nom">{pizza.nom}</Titre>
      <span class="plat__prix">{rs(pizza.prix)}</span>
    </div>
    {pizza.badge && (
      <p class="plat__badge">
        <span class="etiquette">{pizza.badge === 'nouveau' ? libelles.nouveau : libelles.temporaire}</span>
        {pizza.badge === 'temporaire' && pizza.jusquau && <span class="plat__jusquau">{libelles.jusquau} {jourMois(pizza.jusquau)}</span>}
      </p>
    )}
    {pizza.description && <p class="plat__description">{pizza.description}</p>}
    <p class="plat__ingredients">
      {pizza.ingredients.length ? pizza.ingredients.join(', ') : <em>{textes.carte.sansIngredients}</em>}
    </p>
    {pizza.infos.length > 0 && (
      <ul class="plat__infos">
        {pizza.infos.map((i) => <li>{i}</li>)}
      </ul>
    )}
    {pizza.allergenes.length > 0 && (
      <p class="plat__allergenes"><strong>{libelles.allergenes} :</strong> {pizza.allergenes.join(', ')}</p>
    )}
  </div>
  <div class="plat__ajout">
    {pizza.disponible ? (
      <>
        <div class="qte" role="group" aria-label={`${libelles.quantite} — ${pizza.nom}`}>
          <button type="button" class="qte__bouton" data-qte="-1" aria-label={`${libelles.moins} : ${pizza.nom}`}>−</button>
          <input class="qte__valeur" type="text" inputmode="numeric" pattern="[0-9]*" value="1" maxlength="2" aria-label={`${libelles.quantite} : ${pizza.nom}`} data-qte-champ />
          <button type="button" class="qte__bouton" data-qte="1" aria-label={`${libelles.plus} : ${pizza.nom}`}>+</button>
        </div>
        <button type="button" class="btn btn--tomate plat__bouton" data-ajout={pizza.id} data-nom={pizza.nom} data-fait={textes.panier.ajoute}>
          {libelles.ajouter}
        </button>
      </>
    ) : (
      <button type="button" class="btn plat__bouton" disabled>{libelles.indisponible}</button>
    )}
  </div>
</article>
