---
import type { Pizza } from '../lib/types';
import { dessinerPizza } from './illustration';

interface Props {
  pizza: Pick<Pizza, 'id' | 'base' | 'ingredients'>;
  /** Texte alternatif : « Pizza X, composition graphique ». */
  libelle: string;
  class?: string;
}
const { pizza, libelle, class: classe } = Astro.props;
const dessin = dessinerPizza(pizza);
---
<svg class:list={['illustration', classe]} viewBox="0 0 200 200" width="200" height="200" role="img" aria-label={libelle} focusable="false" set:html={dessin} />
