---
import { Image } from 'astro:assets';
import { commerce } from '../config/commerce';
import { imageLogo } from './marque';

interface Props {
  /** Sur fond sombre : « MEMER » passe en crème. */
  clair?: boolean;
  /** Mot-symbole sur deux lignes (héros). */
  empile?: boolean;
  class?: string;
}
const { clair = false, empile = false, class: classe } = Astro.props;
---
{imageLogo ? (
  <Image src={imageLogo} alt={commerce.nom} height={empile ? 96 : 44} class:list={['logo-image', classe]} loading="eager" />
) : (
  <span class:list={['logo', clair && 'logo--clair', empile && 'logo--empile', classe]}>
    <svg class="logo__flamme" viewBox="0 0 24 32" width="22" height="30" aria-hidden="true" focusable="false">
      <path d="M12 1c1 6 9 9 9 18a9 9 0 0 1-18 0c0-4 2-6 4-8 0 3 1 4 3 4-1-6 0-10 2-14z" fill="#c5301c" />
      <path d="M12.5 15c.6 3.200 4.500 4.600 4.500 9a5 5 0 0 1-10 0c0-2 1-3.500 2.200-4.500.2 1.500.9 2 1.800 2-.6-3 0-5 1.500-6.500z" fill="#e09a3c" />
    </svg>
    <span class="logo__mots">
      <span class="logo__pizza">Pizza</span>
      <span class="logo__memer">Memer</span>
    </span>
    <span class="sr-only"> — {commerce.nom}</span>
  </span>
)}
