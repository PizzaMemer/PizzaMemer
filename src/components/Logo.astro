---
import { Image } from 'astro:assets';
import { commerce } from '../config/commerce';
import { imageLogo } from './marque';

interface Props {
  /** Sur fond sombre. */
  clair?: boolean;
  /** Conservé pour compatibilité : le mot-symbole reste sur une ligne. */
  empile?: boolean;
  class?: string;
}
const { clair = false, empile = false, class: classe } = Astro.props;
---
{imageLogo ? (
  <Image src={imageLogo} alt={commerce.nom} height={empile ? 96 : 40} class:list={['logo-image', classe]} loading="eager" />
) : (
  <span class:list={['logo', clair && 'logo--clair', classe]}>
    <span class="logo__mots" aria-hidden="true">
      <span class="logo__pizza">Pizza</span>
      <span class="logo__memer">Memer</span>
    </span>
    <span class="sr-only">{commerce.nom}</span>
  </span>
)}
