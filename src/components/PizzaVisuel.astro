---
/**
 * Visuel d'une pizza : composition graphique (disque vectoriel sur aplat de couleur).
 * Une photo n'est affichée que si apparence.photos = true ET que le fichier existe.
 */
import type { Pizza } from '../lib/types';
import PizzaIllustration from './PizzaIllustration.astro';
import Photo from './Photo.astro';
import { photoPizza } from './marque';
import { FONDS } from './illustration';
import { pizzas } from '../config/pizzas';

interface Props {
  pizza: Pizza;
  sizes?: string;
  class?: string;
}
const { pizza, sizes = '(min-width: 1000px) 380px, (min-width: 640px) 46vw, 116px', class: classe } = Astro.props;
const photo = await photoPizza(pizza.photo, pizza.id);
const rang = Math.max(0, pizzas.findIndex((p) => p.id === pizza.id));
const libelle = `Pizza ${pizza.nom} : composition graphique`;
---
<div class:list={['visuel', classe]} style={`--fond:${FONDS[rang % FONDS.length]}`} data-visuel>
  {photo && pizza.photo ? (
    <div class="cadre"><Photo src={photo} nom={pizza.photo} alt={`Pizza ${pizza.nom}`} widths={[320, 480, 720]} sizes={sizes} /></div>
  ) : (
    <PizzaIllustration pizza={pizza} libelle={libelle} />
  )}
</div>
