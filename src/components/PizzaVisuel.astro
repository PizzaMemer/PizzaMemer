---
/**
 * Visuel rectangulaire d'une pizza : photo réelle (src/assets/pizzas/) si elle existe,
 * sinon un repli sobre : dessin au trait sur fond uni, avec la mention « illustration ».
 */
import type { Pizza } from '../lib/types';
import { textes } from '../content/textes';
import PizzaIllustration from './PizzaIllustration.astro';
import Photo from './Photo.astro';
import { photoPizza } from './marque';

interface Props {
  pizza: Pizza;
  sizes?: string;
  class?: string;
}
const { pizza, sizes = '(min-width: 1000px) 380px, (min-width: 640px) 46vw, 116px', class: classe } = Astro.props;
const photo = photoPizza(pizza.photo, pizza.id);
---
{photo && pizza.photo ? (
  <div class:list={['cadre', 'zoomable', classe]}>
    <Photo src={photo} nom={pizza.photo} alt={`Pizza ${pizza.nom}`} widths={[320, 480, 720]} sizes={sizes} />
  </div>
) : (
  <div class:list={['cadre', 'cadre--dessin', classe]} role="img" aria-label={`${pizza.nom} — ${textes.carte.illustration}`}>
    <PizzaIllustration pizza={pizza} />
    <p class="cadre__mention" aria-hidden="true">{textes.carte.illustration}</p>
  </div>
)}
